[resource]
script = ExtResource("1_8yfee")
title = "Suspicious Protein"
description = "There's a jar of protein powder in the pantry. It expired years ago, but that's never stopped anyone before. Roll more than {0} to gain {1} in {2}"
effect = 3
effect_value = 1
threshold = 2
bad_action = "{0} drinks the ancient protein shake and immediately feels stronger. Science remains undefeated. {1} in {2} gained"
good_action = "{0} decided that expired protein was probably fine. It was not"
