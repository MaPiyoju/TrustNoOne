[resource]
script = ExtResource("1_nsog2")
title = "The Helpful Portrait"
description = "One of the portraits has a small inscription hidden beneath the frame. It might reveal something about the house. Roll more than {0} to understand it and gain {1} in {2}"
effect = 1
effect_value = 1
threshold = 3
bad_action = "{0} figures out the inscription. Apparently, staring at paintings does pay off. {1} in {2} gained"
good_action = "{0} couldn't decipher the inscription. The portrait remains smugly mysterious"
metadata/_custom_type_script = "uid://bnix6barmivun"
