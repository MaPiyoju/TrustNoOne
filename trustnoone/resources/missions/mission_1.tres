[gd_resource type="Resource" script_class="MissionRes" load_steps=2 format=3 uid="uid://bsmsebr6klhnw"]

[ext_resource type="Script" uid="uid://ms0b0ma6out1" path="res://resources/mission.gd" id="1_tinwb"]

[resource]
script = ExtResource("1_tinwb")
title = "The Velvet Masquerade"
description = "An invitation brought seven eccentric strangers to the Lord's estate, but the gates locked behind you. As the fog thickens into a toxic haze, an unnatural hunger spreads through the halls. One guest is not human, and they are hunting the rest."
description_img = "res://assets/sprites/endings/intro_mission_1.png"
good_ending_txt = "You unmasked the impostor before their ritual completed. Severing their grotesque tendrils, you watch the fog lift as dawn breaks over the shattered estate."
good_ending_img = "res://assets/sprites/endings/win_mission_1.png"
bad_ending_txt = "You accepted a goblet of wine from the quiet stranger with the golden eyes. As your limbs turn to stone, you realize too late that you were the final ingredient."
bad_ending_img = "res://assets/sprites/endings/game_over_mission_1.png"
survive_ending_txt = "Ignoring the corpses and the maddening whispers, you barred yourself inside the clock tower. You starved in the dark, but whatever stalked the halls never found your hideout."
survive_ending_img = "res://assets/sprites/endings/survive_mission_0.png"
traitor_threshold = 3
survive_threshold = 7
traitor_excuse = "You think I destroyed the gate mechanism? I was trying to seal us IN! The thing outside is wearing one of our faces!"
allies_txt = Array[String](["Please, try not to wander off alone. This place is unsettling enough as it is", "I don't like the fog. It wasn't this thick when we arrived", "Did you hear that? Please tell me you heard that too", "I suppose we should stay together. At least until we understand what's happening", "That guest has been acting strangely all evening. I wouldn't get too close", "Have you noticed how quiet the servants are? I haven't seen a single one since dinner", "Perhaps we should avoid the west wing. Something about it feels... wrong", "You're not imagining things. I've noticed the paintings moving too", "I'd feel much safer if we could find a way out of this estate", "I don't mean to alarm you, but I think someone has been following us", "Keep your voice down. We don't know what might be listening", "I came here for a masquerade, not to be trapped in some cursed mansion"])
traitor_txt = Array[String](["The Veiled Lady’s fingers are too long... haven't you noticed how she glides without taking steps?", "The Tall Man tried to lock me in the pantry—he's trying to separate us so he can pick us off one by one!", "Don't listen to the Jester! His bandages aren't hiding wounds, they're hiding teeth!", "Stay close. I don't care who you trust anymore, just don't wander off", "Someone is lying to us. I'm certain of it", "Keep watching the others. One of them knows more than they're saying", "I don't know who to believe anymore", "Nobody touches that door until we know exactly what we're dealing with", "Don't take this personally, but I'm keeping an eye on you", "If that thing can wear our faces, how do we know we're talking to the right person?", "Everyone has an explanation. That's what worries me", "Maybe the monster isn't outside anymore", "Someone here is protecting that thing. We just don't know who", "I'm starting to think the safest person in this house might be the one we fear most", "If you're hiding something, now would be a very good time to confess"])
dead_txt = "Keep going, i 'm already dead"
metadata/_custom_type_script = "uid://ms0b0ma6out1"
