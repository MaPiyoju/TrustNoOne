[ext_resource type="Script" uid="uid://ms0b0ma6out1" path="res://resources/mission.gd" id="1_tinwb"]

[resource]
script = ExtResource("1_tinwb")
title = "The Velvet Masquerade"
description = "An invitation brought seven eccentric strangers to the Lord's estate, but the gates locked behind you. As the fog thickens into a toxic haze, an unnatural hunger spreads through the halls. One guest is not human, and they are hunting the rest."
description_img = "res://assets/sprites/endings/intro_mission_1.png"
good_ending_txt = "You unmasked the impostor before their ritual completed. Severing their grotesque tendrils, you watch the fog lift as dawn breaks over the shattered estate."
good_ending_img = "res://assets/sprites/endings/win_mission_1.png"
bad_ending_txt = "You accepted a goblet of wine from the quiet stranger with the golden eyes. As your limbs turn to stone, you realize too late that you were the final ingredient."
bad_ending_img = "res://assets/sprites/endings/game_over_mission_1.png"
survive_ending_txt = "Ignoring the corpses and the maddening whispers, you barred yourself inside the clock tower. You starved in the dark, but whatever stalked the halls never found your hideout."
survive_ending_img = "res://assets/sprites/endings/survive_mission_0.png"
traitor_threshold = 3
survive_threshold = 7
traitor_excuse = "You think I destroyed the gate mechanism? I was trying to seal us IN! The thing outside is wearing one of our faces!"
allies_txt = Array[String](["The Tall Man in the velvet suit twitches uncontrollably, whispering that the paintings are watching us move.", "The Veiled Lady refuses to show her hands, but she offered you a rusted brass key she found in the conservatory.", "The Bandaged Jester keeps humming a lullaby, pointing frantically at the wet footprints leading toward the basement."])
traitor_txt = Array[String](["The Veiled Lady’s fingers are too long... haven't you noticed how she glides without taking steps?", "The Tall Man tried to lock me in the pantry—he's trying to separate us so he can pick us off one by one!", "Don't listen to the Jester! His bandages aren't hiding wounds, they're hiding teeth!"])
metadata/_custom_type_script = "uid://ms0b0ma6out1"
