[ext_resource type="Script" uid="uid://ms0b0ma6out1" path="res://resources/mission.gd" id="1_dc3bd"]

[resource]
script = ExtResource("1_dc3bd")
title = "Weekend with friends"
description = "It’s always refreshing to escape for a getaway with “friends.” I’d love to return to that house in the woods—it certainly wasn’t cheap. Perhaps next time with different company. These “friends” are a little unhinged, but they were the only ones willing to split the cost of the place."
description_img = ""
good_ending_txt = "The nightmare is over. You made it out alive. you're safe."
good_ending_img = "res://assets/sprites/endings/win.png"
bad_ending_txt = "Your blood stains the pavement. Darkness swallows the rest."
bad_ending_img = "res://assets/sprites/endings/game_over_bad.png"
survive_ending_txt = "The nightmare is over. You made it out alive. you're safe."
survive_ending_img = "res://assets/sprites/endings/win.png"
traitor_threshold = 2
survive_threshold = 3
traitor_excuse = "You hear a scream. Apparently, someone is paying for every corpse. So much for splitting the rent"
allies_txt = Array[String](["Always nice to spend time with people you absolutely trust", "Nothing says friendship like sharing a house in the middle of nowhere", "We may not like each other, but at least we paid together", "A lovely weekend with people I would never invite twice", "Friends forever. Unfortunately", "I suppose this is what friendship looks like now", "They’re unbearable, but they paid their share", "Nothing could possibly go wrong with this group", "A charming bunch. From a safe distance", "I’d rather be here with strangers. But here we are", "We all get along beautifully. When nobody speaks", "Good friends are hard to find. So are affordable cabins", "I trust them about as far as I can throw this house", "At least we can agree on one thing: the bill was too expensive", "Some friendships are built on trust. Ours was built on splitting the rent"])
traitor_txt = Array[String](["So... which one of you is lying?", "Funny how quickly friendship falls apart", "I knew I shouldn't have trusted you", "Keep smiling. It makes you look even more suspicious", "You expect me to believe that?", "Careful. I'm watching you", "We were \"friends\" five minutes ago. What happened?", "I don't know who's worse: the traitor or the liar", "Nobody leaves my sight. Especially you", "Trust is a luxury we can no longer afford", "You’ve been acting strangely. Very strangely", "One of us is lying. I'm just not sure who yet", "If you’re innocent, you have nothing to worry about. Right?", "Funny. You seem very nervous for someone who's innocent", "The house isn't the dangerous part. It's the people inside it", "I don't need proof. I just need to know who to watch", "You were a terrible friend. You're an even worse liar", "I trusted you. That was my mistake", "From now on, nobody gets the benefit of the doubt"])
metadata/_custom_type_script = "uid://ms0b0ma6out1"
